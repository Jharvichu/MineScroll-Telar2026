  m_Name: 
  m_EditorClassIdentifier: 
  dialogoTerminado: 0
  panel: {fileID: 178277624}
  imageUI: {fileID: 768129730}
  textoUI: {fileID: 498582093}
  velocidadEscritura: 0.05
  dialogueLines:
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: "Esas ni\xF1as no lucen mayores que mi primita..."
    duration: 1.8
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: "No deben tener m\xE1s de 15 a\xF1os."
    duration: 1.5
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: Muchos avisos en Cusco ofrecen trabajos en Madre de Dios.
    duration: 2
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: Mi prima pudo ser una de ellas...
    duration: 2
