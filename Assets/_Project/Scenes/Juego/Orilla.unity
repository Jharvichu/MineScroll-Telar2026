--- !u!114 &785397324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 785397323}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5374bf6959724364c9602c33ec751382, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cambioEscena: {fileID: 944889287}
  panelA: {fileID: 1748405222}
  panelB: {fileID: 961616317}
  imageA: {fileID: 1495002030}
  imageB: {fileID: 32718770}
  tmpA: {fileID: 33007780}
  tmpB: {fileID: 2067331691}
  velocidadEscritura: 0.04
  dialogueLines:
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: "Mire. Hasta aqu\xED la tengo que dejar."
    duration: 2
    isCharacterA: 0
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: "\xBFNo podr\xEDa dejarme un poco m\xE1s cerca, Don M\xE1ximo?"
    duration: 2.2
    isCharacterA: 1
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: "Se\xF1orita Mar\xEDa, me espera mi familia en casa."
    duration: 2.2
    isCharacterA: 0
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: "Tenga mucho cuidado. Oc\xFAltese de la gente de Uchu."
    duration: 2.2
    isCharacterA: 0
  - image: {fileID: -8551478148450923529, guid: fd2bbf71e2e327441ba3265f390deb1f, type: 3}
    textoAMostrar: "Ah\xED el diablo perdi\xF3 el trinche."
    duration: 3.2
    isCharacterA: 0
