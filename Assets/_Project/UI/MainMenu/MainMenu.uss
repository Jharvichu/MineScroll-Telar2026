.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

#titleLabel {
    font-size: 70px;
    color: white;
    margin-bottom: 30px;
}

.button-container {
    width: 20%;
    min-width: 300px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

Button {
    width: 20%;
    height: 80px;
    margin: 20px;
    font-size: 60px;
    transition: background-color 0.15s, scale 0.1s;
    
    transition: scale 0.1s, -unity-background-image-tint-color 0.1s;
}

Button:hover {
       scale: 1.1 !important;   
    color: red;
    -unity-text-outline-width: 0;
    
}

Button:active {
    scale: 0.95;
    color: red !important;
}

.unity-text-element {
}
