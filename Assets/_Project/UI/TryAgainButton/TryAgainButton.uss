.game-button {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0,0,0,0);
    border-right-color: rgba(0,0,0,0);
    border-top-color: rgba(0,0,0,0);
    border-bottom-color: rgba(0,0,0,0);
}

.game-button:hover {
    background-color: rgba(0,0,0,0);
    scale: 1.1;
    color: rgb(0,0,0);
    -unity-background-image-tint-color: rgb(96,20,20); /* Tinte rojo oscuro original */
}

.game-button:active {
    background-color: rgba(0,0,0,0);
    scale: 0.95;
    -unity-background-image-tint-color: rgba(140,115,199,0.65); /* Tinte morado original */
}

/* Estilo específico para el nuevo botón de Siguiente */
.next-button:hover {
    -unity-background-image-tint-color: rgb(20, 96, 20); /* Un tinte verde oscuro para diferenciar */
}